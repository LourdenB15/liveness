{
  "name": "liveness-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/demo",
    "dev:saas": "npm run dev -w apps/saas-web",
    "dev:api": "npm run dev -w apps/saas-api",
    "build": "npm run build -w packages/sdk && npm run build -w apps/demo",
    "build:saas": "npm run build -w packages/sdk && npm run build -w apps/saas-web",
    "build:sdk": "npm run build -w packages/sdk",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w packages/engine",
    "setup:agents": "node scripts/setup-agent-skills.js",
    "postinstall": "node scripts/patch-mediapipe.js && node scripts/install-win-rollup.js",
    "install:win-rollup": "node scripts/install-win-rollup.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.54.0",
    "@rollup/rollup-darwin-x64": "^4.54.0",
    "@rollup/rollup-linux-arm64-gnu": "^4.54.0",
    "@rollup/rollup-linux-x64-gnu": "^4.54.0",
    "@rollup/rollup-win32-x64-msvc": "^4.54.0"
  }
}
