PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
JWT_SECRET=your-secure-jwt-secret-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://liveness.cloud
APP_URL=https://liveness.cloud
# COOKIE_SAME_SITE defaults to 'none' in production (required for cross-site auth like liveness.cloud -> onrender.com)
COOKIE_SAME_SITE=none

# Optional: Email password reset
GMAIL_USER=
GMAIL_APP_PASSWORD=
